# Street Banker — environment template.
# Copy to .env (never commit the real one). Everything here is optional:
# the app runs without any of it, and Signal runs in demo mode.

# --- core -------------------------------------------------------------------
# SECRET_KEY=                     # generated by the Render blueprint in prod
# DATABASE_PATH=/var/data/streetbanker.db
# PUBLIC_BASE_URL=https://street-banker.onrender.com

# Owner access. Comma-separated addresses; these accounts are enrolled as
# owners of the Operator Desk and Street Banker Signal on first sight. This is
# how access is granted — never by writing a person's name into the source.
# OWNER_EMAILS=someone@example.com,someone-else@example.com

# --- Street Banker Signal: provider adapters --------------------------------
# Every flag defaults to off. With none enabled Signal serves a deterministic,
# entirely fictional demo universe and says so on every screen. Enabling a
# flag without its credentials shows the adapter as "enabled but missing
# credentials" in /signal/admin/data-sources rather than failing silently.
#
# Signal is provider-agnostic: each capability (artist identity, metrics,
# cities, playlists, social, releases, distributor, label, contacts, rights)
# is served by whichever enabled adapter claims it, so different providers may
# power different parts of the product.

# SOUNDCHARTS_ENABLED=1
# New integrations: OAuth client credentials (team id optional)
# SOUNDCHARTS_CLIENT_ID=
# SOUNDCHARTS_CLIENT_SECRET=
SOUNDCHARTS_ACCESS_TOKEN=
# SOUNDCHARTS_TEAM_ID=
# Integrations issued an app id + api key before OAuth (still accepted)
# SOUNDCHARTS_APP_ID=
# SOUNDCHARTS_API_KEY=

# CHARTMETRIC_ENABLED=1
# CHARTMETRIC_REFRESH_TOKEN=

# MUSICBRAINZ_ENABLED=1
# MUSICBRAINZ_CONTACT=            # their policy requires a contact in the UA

# MLC_ENABLED=1
# MLC_USERNAME=          # issued by The MLC for its Public Search API
# MLC_PASSWORD=

# SOUNDEXCHANGE_ENABLED=1
# SOUNDEXCHANGE_API_KEY=

# SPOTIFY_METADATA_ENABLED=1
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Public web research for professional contacts. Official sites, rosters and
# press only — never private accounts, never guessed addresses presented as
# confirmed, and always subject to the source's terms and robots directives.
# WEB_ENRICHMENT_ENABLED=1

# Internal Street Banker distribution/royalty data as a Signal source.
# INTERNAL_REVENUE_ENABLED=1

# Reserved for later phases; interfaces exist, functionality does not.
# PRIVATE_AUDIO_ENABLED=0
# AUDIO_INTELLIGENCE_ENABLED=0

# --- TOUR: ticket sales ------------------------------------------------------
# A private token from https://www.eventbrite.com/platform/api-keys (the
# account's own OAuth token, not a client id). Read-only: TOUR reads the
# account's events and their ticket classes to fill a date's sold count,
# on-sale status, capacity and ticket link. Without it the tour home says so.
EVENTBRITE_TOKEN=
# A consumer key from https://developer.ticketmaster.com (register an app;
# the Discovery API tier is free — 5 calls a second, 5,000 a day). Sent as
# ?apikey=. The same Sync ticket sales button asks Ticketmaster about the
# dates Eventbrite could not match. Their Discovery API is a public listing:
# it publishes the ticket link, the on-sale status and the announced date and
# NOTHING about how many tickets sold or how big the room is, so this source
# never writes tickets_sold or capacity. Without it nothing is looked up there
# and the tour home names this variable.
TICKETMASTER_API_KEY=

# --- email / other integrations ---------------------------------------------
# RESEND_API_KEY=
# EMAIL_FROM=

# --- Street Banker Audio Intelligence ---------------------------------------
# Nothing here is required. With none of it set the app runs on the mock
# adapters: everything works offline, no network call is made, and every
# result is labelled as a mock.

# The umbrella. Off means the whole audio surface is absent, not hidden.
AUDIO_INTELLIGENCE_ENABLED=

# Per-feature switches. Each also needs the umbrella above.
MEETING_INTELLIGENCE_ENABLED=
SIGNAL_AUDIO_BRIEFS_ENABLED=
AUDIO_OPERATOR_ENABLED=
GLOBAL_RELEASE_PACK_ENABLED=
CAMPAIGN_AUDIO_TOOLKIT_ENABLED=
REMIX_LAB_AUDIO_ENGINE_ENABLED=
ARTIST_VOICE_VAULT_ENABLED=
WHITE_LABEL_AUDIO_OPERATOR_ENABLED=
DUBBING_ENABLED=
MUSIC_GENERATION_ENABLED=
MUSIC_INPAINTING_ENABLED=
STEM_SEPARATION_ENABLED=
VOICE_ISOLATION_ENABLED=
SOUND_EFFECTS_ENABLED=
VOICE_CLONING_ENABLED=

# --- vendor: ElevenLabs -------------------------------------------------------
# Paste the key into the host's Environment settings (Render dashboard), never
# into a chat, a commit, or a screenshot. The key is read server-side only and
# is never sent to a browser.
ELEVENLABS_ENABLED=
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=

# There is deliberately no ELEVENLABS_VERIFIED switch. An earlier draft of the
# adapter had one, because it was written against guessed endpoints and needed
# a human to vouch that they were real. It is now written against the official
# SDK and health() is MEASURED - it makes a live call and reports what came
# back. An operator asserting "this works" is not evidence that it does, so the
# switch was removed rather than left to be set in hope.

# Which models to ask for. Pinned here rather than in code so a deprecation is
# a settings change, not a deploy. Model ids move - check the vendor's current
# list before changing one.
ELEVENLABS_STT_MODEL=
ELEVENLABS_TTS_MODEL=

# Set to 1 ONLY with written confirmation from the vendor that THIS ACCOUNT is
# configured for zero-retention processing for the products in use. A partner
# whose policy requires zero retention cannot use the provider until this is
# true - which is the correct outcome, not a bug to work around.
ELEVENLABS_ZERO_RETENTION_VERIFIED=

# --- vendor: ACRCloud ---------------------------------------------------------
# TWO CREDENTIALS, TWO JOBS. The project access key/secret below sign the
# identify call - "what is this twelve seconds of audio" - on the identify
# host. They cannot manage the account.
# ACRCLOUD_HOST=identify-us-west-2.acrcloud.com
# ACRCLOUD_ACCESS_KEY=
# ACRCLOUD_ACCESS_SECRET=
#
# The console token is the other half: it lists the account's custom buckets,
# registers your own masters into one, and reads a file-scanning job. Mint it
# in the ACRCloud console with exactly three scopes - read-buckets (list the
# buckets), write-audios (put a master in one), read-filescanning (read a
# scan and its detections). Unset, /fingerprints says which variable is
# missing and makes no call at all.
ACRCLOUD_CONSOLE_TOKEN=
