# Local development — SQLite, no external services.
DATABASE_URL="file:./prisma/dev.db"

# Deployment — the driver is detected from the string.
# Turso (SQLite over the network; reuses the committed SQLite migrations):
# DATABASE_URL="libsql://your-db.turso.io"
# DATABASE_AUTH_TOKEN=""
# PostgreSQL:
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# AI provider. The default deterministic parser needs no key and no network.
CANVAS_AI_PROVIDER="deterministic"
# CANVAS_AI_PROVIDER="anthropic"
# ANTHROPIC_API_KEY=""
# CANVAS_AI_MODEL="claude-sonnet-4-5"

# Storage root. Defaults to .storage locally, /tmp on a serverless host.
# CANVAS_STORAGE_DIR=""
