{
  "name": "canvas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "npm run prepare:db",
    "db:migrate": "npm run prepare:db && prisma migrate deploy",
    "db:seed": "npm run prepare:db && prisma db seed",
    "db:reset": "npm run prepare:db && prisma migrate reset --force",
    "db:migrate:new": "npm run prepare:db && prisma migrate dev",
    "vercel-build": "npm run deploy:build",
    "deploy:build": "npm run prepare:db && prisma migrate deploy && prisma db seed && next build",
    "prepare:db": "node scripts/prepare-schema.mjs && prisma generate"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-libsql": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/three": "^0.185.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "next": "16.3.0",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
