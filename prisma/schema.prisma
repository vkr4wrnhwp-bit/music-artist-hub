// CANVAS — Precision Manufacturing Intelligence
//
// Schema notes
// ------------
// Development uses SQLite so the application runs with no external services.
// The schema is written to move to PostgreSQL without restructuring: no
// SQLite-specific types are used, and enumerated values are stored as strings
// validated in the domain layer (src/lib/domain) rather than as native enums,
// which keeps a single source of truth for the vocabulary and keeps the
// migration to Postgres a provider swap. See /docs/ARCHITECTURE.md.
//
// Every table that carries manufacturing meaning is organisation-scoped and
// revision-aware. Audit rows are append-only.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"

}

/* ================================================================== */
/* Identity and tenancy                                               */
/* ================================================================== */

model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  industry     String?
  website      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Onboarding answers — drives what CANVAS asks and what it can validate.
  businessType     String?
  typicalTolerance Float?
  typicalQuantity  String?
  outsourced       String? // JSON array
  bottlenecks      String? // JSON array
  onboardingDone   Boolean @default(false)

  // Network participation. PRIVATE unless explicitly changed by a human.
  defaultSharing String @default("PRIVATE")

  users        User[]
  shops        Shop[]
  parts        Part[]
  machines     Machine[]
  tools        Tool[]
  workholding  WorkholdingDevice[]
  jawBlanks    JawBlank[]
  jawSets      JawSet[]
  materials    Material[]
  metrology    MetrologyDevice[]
  jobs         Job[]
  quotes       Quote[]
  suppliers    Supplier[]
  assets       UploadedAsset[]
  auditLogs    AuditLog[]
  conversations Conversation[]
  fingerprints NetworkFingerprint[]
  permissions  NetworkPermission[]
  shopKnowledge ShopKnowledge[]
  disagreements Disagreement[]
  ncExportAuthorizations NCExportAuthorization[]
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  passwordHash   String
  role           String   @default("ENGINEER") // OWNER | ENGINEER | MACHINIST | VIEWER
  organizationId String
  createdAt      DateTime @default(now())
  lastSeenAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions     Session[]
  auditLogs    AuditLog[]
  approvals    Approval[]
  shopKnowledge ShopKnowledge[]
  disagreements Disagreement[]

  @@index([organizationId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Shop {
  id             String @id @default(cuid())
  organizationId String
  name           String
  location       String?
  shiftHours     Float  @default(8)
  machineRate    Float  @default(75)
  operatorRate   Float  @default(38)
  inspectionRate Float  @default(45)
  overheadRate   Float  @default(0.18)
  marginRate     Float  @default(0.32)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/* ================================================================== */
/* Shop resources                                                     */
/* ================================================================== */

model Machine {
  id             String @id @default(cuid())
  organizationId String
  manufacturer   String
  model          String
  controller     String
  machineType    String
  axisCount      Int    @default(3)

  travelsX Float
  travelsY Float
  travelsZ Float
  tableX   Float
  tableY   Float

  maxSpindleRPM   Int
  maxSpindlePower Float
  maxSpindleTorque Float
  maxFeed         Float
  maxRapid        Float
  // Axis acceleration, in/s². Null when not recorded — time estimates then
  // stay distance-over-feed and say so, rather than assuming a value.
  axisAccel       Float?

  toolChangerCapacity Int
  maxToolDiameter     Float
  maxToolLength       Float
  maxToolWeight       Float

  coolantTypes          String  // JSON array
  throughSpindleCoolant Boolean @default(false)
  probe                 Boolean @default(false)
  toolSetter            Boolean @default(false)
  fourthAxis            Boolean @default(false)
  fifthAxis             Boolean @default(false)

  supportedPostProcessor String
  // Reference profiles are seeded example data, never presented as verified.
  isReferenceProfile     Boolean @default(false)
  notes                  String?
  createdAt              DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  setups       Setup[]
  ncPrograms   NCProgram[]
  shopKnowledge ShopKnowledge[]

  @@index([organizationId])
}

model Tool {
  id             String @id @default(cuid())
  organizationId String
  toolNumber     Int
  toolClass      String
  manufacturer   String?
  product        String?
  description    String

  diameter     Float
  cornerRadius Float @default(0)
  flutes       Int
  material     String
  coating      String?
  fluteLength  Float
  overallLength Float
  stickout     Float

  holderId String?
  holder   ToolHolder? @relation(fields: [holderId], references: [id], onDelete: SetNull)

  maxRPM               Int
  recommendedMaterials String // JSON array
  chiploadMin          Float
  chiploadMax          Float
  sfmMin               Float
  sfmMax               Float
  coolant              String
  lifeRemaining        Float  @default(1)
  costPerTool          Float  @default(0)
  expectedLifeMinutes  Float  @default(120)
  notes                String?

  // Tool reality. What is actually in the holder, as opposed to what the
  // catalogue page said. The cutting model reads condition and helix; a worn
  // edge ploughs rather than cuts and raises specific cutting force.
  condition        String  @default("UNKNOWN") // NEW | GOOD | WORN | REGRIND | UNKNOWN
  actualStickout   Float?
  measuredRunout   Float?
  helixAngle       Float?
  regrindCount     Int     @default(0)
  previousMaterial String?
  lastUsedAt       DateTime?
  shopNotes        String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  operations   Operation[]
  shopKnowledge ShopKnowledge[]

  @@unique([organizationId, toolNumber])
  @@index([organizationId])
}

model ToolHolder {
  id                String @id @default(cuid())
  description       String
  taper             String // CAT40 | BT30 | HSK63 | ER32 ...
  noseDiameter      Float
  gaugeLength       Float
  taperAngleDegrees Float  @default(0)
  tools             Tool[]
}

model WorkholdingDevice {
  id             String @id @default(cuid())
  organizationId String
  type           String
  manufacturer   String?
  model          String?
  description    String

  jawWidth      Float
  jawHeight     Float
  maxOpening    Float
  clampForce    Float?
  fixtureHeight Float
  mountingGeometry   String?
  hasCadRepresentation Boolean @default(false)
  notes          String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  setups       Setup[]
  jaws         Jaw[]

  @@index([organizationId])
}

model JawBlank {
  id             String @id @default(cuid())
  organizationId String
  material       String
  width          Float
  height         Float
  thickness      Float
  boltPattern    String
  quantityOnHand Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jaws         Jaw[]

  @@index([organizationId])
}

// A generated soft jaw pair, stored as parametric geometry plus the process
// needed to cut it. Geometry is simplified in Phase 1; the record is not.
model Jaw {
  id          String @id @default(cuid())
  setupId     String?
  deviceId    String?
  blankId     String?
  side        String // LEFT | RIGHT
  stepDepth   Float
  stepHeight  Float
  seatWidth   Float
  seatDepth   Float
  seatCornerRadius Float
  stopLocation Float?
  reliefRadius Float
  clampingDirection String @default("X")
  processJson String // the machining sequence, as generated
  createdAt   DateTime @default(now())

  setup  Setup?             @relation(fields: [setupId], references: [id], onDelete: Cascade)
  device WorkholdingDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  blank  JawBlank?          @relation(fields: [blankId], references: [id], onDelete: SetNull)

  @@index([setupId])
}

// A machined soft jaw set sitting in the drawer, described by what it can
// hold rather than by the part it was originally cut for. This is the record
// that turns soft jaws from a per-job expense into shop tooling: a jaw bored
// 6.000 holds everything down to what the shim stack allows.
model JawSet {
  id             String @id @default(cuid())
  organizationId String
  name           String
  profile        String // ROUND | RECTANGULAR
  // Bore diameter for ROUND, opening across the clamped axis for RECTANGULAR.
  nominalSize    Float
  nominalLength  Float?
  stepDepth      Float
  jawHeight      Float
  material       String
  viseDescription String
  // Drives amortisation — the whole argument for cutting a family size.
  timesUsed      Int    @default(0)
  minutesToCut   Float  @default(35)
  notes          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Material {
  id             String @id @default(cuid())
  organizationId String
  name           String
  family         String
  condition      String
  density        Float
  hardness       Float?
  yieldStrength  Float?
  tensileStrength Float?
  machinabilityRating Float
  sfmCarbideMin  Float
  sfmCarbideMax  Float
  // Specific cutting energy, hp/in³/min — drives the cutting force model.
  specificEnergy Float  @default(0.3)
  costPerPound   Float
  weldable       Boolean @default(true)
  castable       Boolean @default(false)
  notes          String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shopKnowledge ShopKnowledge[]

  @@index([organizationId])
}

model MetrologyDevice {
  id             String @id @default(cuid())
  organizationId String
  deviceType     String
  description    String
  rangeMin       Float?
  rangeMax       Float?
  resolution     Float
  uncertainty    Float
  calibrated     Boolean @default(false)
  calibrationDue DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  measurements Measurement[]

  @@index([organizationId])
}

/* ================================================================== */
/* Parts and revisions                                                */
/* ================================================================== */

model Part {
  id             String @id @default(cuid())
  organizationId String
  name           String
  partNumber     String?
  description    String?
  // PRIVATE unless a human changes it. Never defaulted upward.
  sharing        String @default("PRIVATE")
  isDemo         Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  revisions     PartRevision[]
  conversations Conversation[]
  jobs          Job[]
  quotes        Quote[]
  assets        UploadedAsset[]
  fingerprints  NetworkFingerprint[]
  dna           ManufacturingDNA[]

  @@index([organizationId])
}

model PartRevision {
  id       String @id @default(cuid())
  partId   String
  revision String // A, B, C ...
  status   String @default("DRAFT") // DRAFT | RELEASED | SUPERSEDED
  createdAt DateTime @default(now())

  // The Part Intent Model, stored whole. Each field carries provenance, so it
  // is kept as a single validated document rather than shredded into columns
  // that would lose the source/confidence pairing.
  intentJson String

  units            String @default("IN")
  stockJson        String?
  notes            String?

  part               Part                     @relation(fields: [partId], references: [id], onDelete: Cascade)
  features           Feature[]
  responsibility     PartResponsibilityProfile?
  setups             Setup[]
  drawings           Drawing[]
  measurementSessions MeasurementSession[]
  inspectionPlans    InspectionPlan[]
  costEstimates      CostEstimate[]
  ncPrograms         NCProgram[]
  approvals          Approval[]
  recommendations    AIRecommendation[]
  operationStates    OperationState[]
  disagreements      Disagreement[]
  datums             Datum[]

  @@unique([partId, revision])
  @@index([partId])
}

model Feature {
  id             String @id @default(cuid())
  partRevisionId String
  kind           String
  label          String
  functionalRole String @default("NONE")
  critical       Boolean @default(false)

  // Parametric definition, shape depends on kind. Validated in the domain layer.
  parametersJson String

  tolerancePlus  Float?
  toleranceMinus Float?
  surfaceFinish  Float?
  inspectionMethod String?

  // FUNCTION BEFORE DIMENSION
  //
  // What this feature has to interface with. A dimension without this is a
  // number; with it, the tolerance follows from the standard rather than from
  // whatever the worn original happened to measure.
  matingComponent   String?  // BEARING | BUSHING | SHAFT | SEAL | FASTENER | DOWEL | UNKNOWN
  matingDesignation String?  // e.g. "6203-2RS", when the operator knows it
  interfaceSide     String?  // HOUSING (feature is the hole) | SHAFT (feature is the journal)
  rotatingUnderLoad Boolean  @default(false)
  // Fit class accepted by a human. Never written by inference alone.
  fitClass          String?
  notes          String?
  orderIndex     Int    @default(0)

  partRevision PartRevision @relation(fields: [partRevisionId], references: [id], onDelete: Cascade)
  operations   Operation[]
  measurements Measurement[]
  inspectionItems InspectionItem[]
  datums       Datum[]

  @@index([partRevisionId])
}

// Kept separate from PartIntent because it is asked, answered and audited as
// its own interview, and because it gates process recommendations.
model PartResponsibilityProfile {
  id             String @id @default(cuid())
  partRevisionId String @unique

  loadBearing         Boolean?
  safetyCritical      Boolean?
  failureConsequence  String? // LOW | MEDIUM | HIGH | CRITICAL
  loadingTypes        String  @default("[]") // JSON array
  environments        String  @default("[]") // JSON array
  temperatureMin      Float?
  temperatureMax      Float?
  serviceLifeYears    Float?
  productionIntent    String?
  annualVolume        Int?
  regulatory          String  @default("[]") // JSON array
  materialCertRequired Boolean?
  traceabilityRequired Boolean?
  inspectionRequirements String @default("[]") // JSON array
  answeredBy          String?
  answeredAt          DateTime?

  partRevision PartRevision @relation(fields: [partRevisionId], references: [id], onDelete: Cascade)
}

model Drawing {
  id             String @id @default(cuid())
  partRevisionId String
  assetId        String?
  title          String
  sheetNumber    String?
  extractedText  String?
  processingState String @default("PENDING")

  partRevision PartRevision   @relation(fields: [partRevisionId], references: [id], onDelete: Cascade)
  asset        UploadedAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([partRevisionId])
}

model UploadedAsset {
  id             String @id @default(cuid())
  organizationId String
  partId         String?
  revision       String?
  kind           String // PHOTO | DRAWING | CAD | SCAN | OTHER
  filename       String
  mimeType       String
  size           Int
  checksum       String
  storageKey     String
  uploadedBy     String
  privacy        String @default("PRIVATE")
  processingState String @default("STORED")
  extractedMetadata String?
  // Reverse engineering photo set orientation, when applicable.
  viewLabel      String?
  scaleReference String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  part         Part?        @relation(fields: [partId], references: [id], onDelete: Cascade)
  drawings     Drawing[]
  measurements Measurement[]

  @@index([organizationId])
  @@index([partId])
}

/* ================================================================== */
/* Reverse engineering and metrology                                  */
/* ================================================================== */

model MeasurementSession {
  id             String @id @default(cuid())
  partRevisionId String
  name           String
  mode           String @default("REVERSE_ENGINEER") // REVERSE_ENGINEER | INSPECTION
  status         String @default("IN_PROGRESS")
  operator       String?
  temperatureF   Float?
  startedAt      DateTime @default(now())
  completedAt    DateTime?
  notes          String?

  partRevision PartRevision  @relation(fields: [partRevisionId], references: [id], onDelete: Cascade)
  measurements Measurement[]

  @@index([partRevisionId])
}

model Measurement {
  id        String @id @default(cuid())
  sessionId String
  featureId String?
  assetId   String?
  deviceId  String?

  label       String
  measuredValue Float
  units       String @default("IN")
  // Uncertainty carried from the instrument used, not assumed.
  uncertainty Float
  repeatCount Int    @default(1)
  context     String @default("GENERAL") // BORE | SHAFT | HOLE | THREAD | THICKNESS | GENERAL

  // Nominal reasoning output. Nothing here is ever applied automatically.
  suggestedNominal      Float?
  suggestedNominalLabel String?
  suggestedFamily       String?
  suggestionConfidence  Float?
  suggestionBasis       String?
  resolution            String  @default("PENDING") // PENDING | ACCEPTED_NOMINAL | KEPT_MEASURED | INVESTIGATING
  resolvedValue         Float?
  resolvedBy            String?
  resolvedAt            DateTime?

  // Dependency graph: which measurements must exist before this one is valid.
  dependsOn String @default("[]") // JSON array of Measurement ids

  // What this dimension is measured FROM. A number without this is not
  // reproducible: the next person measures from a different edge and gets a
  // different answer that is equally defensible.
  datumId   String?

  createdAt DateTime @default(now())

  session MeasurementSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  feature Feature?           @relation(fields: [featureId], references: [id])
  asset   UploadedAsset?     @relation(fields: [assetId], references: [id], onDelete: SetNull)
  device  MetrologyDevice?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  datum   Datum?             @relation(fields: [datumId], references: [id], onDelete: SetNull)

  @@index([sessionId])
}

/* ================================================================== */
/* Manufacturing plan                                                 */
/* ================================================================== */

model Setup {
  id             String @id @default(cuid())
  partRevisionId String
  sequence       Int
  name           String
  orientation    String @default("TOP") // which face is up
  machineId      String?
  workholdingId  String?

  workOffset     String @default("G54")
  datumNote      String?

  // Setup geometry that the workholding engine reasons over.
  gripDepth       Float?
  gripLength      Float?
  stockProjection Float?
  parallelHeight  Float?

  // Inputs to the force-based holding margin. Grip depth alone decides nothing.
  jawSurface      String?  // SMOOTH | SERRATED | SOFT_MACHINED | GRIP_INSERT
  clampForce      Float?   // lbf actually applied, overriding the device record
  hasPositiveStop Boolean  @default(false)
  loadDirection   String?

  // Cached assessment output, recomputed on change. Stored so a job record
  // preserves what the risk looked like when the part was actually run.
  riskLevel       String?
  riskFactorsJson String?

  estimatedCycleMinutes Float?
  notes           String?

  partRevision PartRevision       @relation(fields: [partRevisionId], references: [id], onDelete: Cascade)
  machine      Machine?           @relation(fields: [machineId], references: [id], onDelete: SetNull)
  workholding  WorkholdingDevice? @relation(fields: [workholdingId], references: [id], onDelete: SetNull)
  operations   Operation[]
  jaws         Jaw[]
  simulations  Simulation[]

  @@unique([partRevisionId, sequence])
  @@index([partRevisionId])
}

model Operation {
  id         String @id @default(cuid())
  setupId    String
  featureId  String?
  toolId     String?
  sequence   Int
  type       String
  label      String

  topZ       Float
  finalZ     Float
  clearanceZ Float @default(0.25)
  retractZ   Float @default(1)

  // Overrides only. Anything absent is derived from tool + material.
  overridesJson String?

  // Engine output.
  parametersJson String?
  cycleTimeMinutes Float?
  materialRemoved  Float?
  cuttingDistance  Float?
  warningsJson     String?
  isPlaceholder    Boolean @default(false)
  errorReason      String?

  setup   Setup    @relation(fields: [setupId], references: [id], onDelete: Cascade)
  feature Feature? @relation(fields: [featureId], references: [id])
  tool    Tool?    @relation(fields: [toolId], references: [id], onDelete: SetNull)
  toolpath Toolpath?

  @@index([setupId])
}

// Toolpaths are stored separately from operations: they are large, they are
// regenerated often, and they are the artefact a simulation or post consumes.
model Toolpath {
  id          String @id @default(cuid())
  operationId String @unique
  movesJson   String
  moveCount   Int
  generatedAt DateTime @default(now())
  engineVersion String @default("phase1-prototype")

  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
}

model Simulation {
  id        String @id @default(cuid())
  setupId   String
  kind      String @default("VISUALIZATION") // VISUALIZATION only in Phase 1
  status    String @default("COMPLETE")
  // Phase 1 does not perform stock removal or collision detection. This flag
  // exists so no consumer can mistake a visualisation for a verification.
  verifiedStockRemoval Boolean @default(false)
  collisionChecked     Boolean @default(false)
  resultJson String?
  runAt     DateTime @default(now())

  setup Setup @relation(fields: [setupId], references: [id], onDelete: Cascade)

  @@index([setupId])
}

model NCProgram {
  id             String @id @default(cuid())
  partRevisionId String
  machineId      String?
  postId         String
  programNumber  String
  workOffset     String @default("G54")
  units          String @default("IN")
  code           String
  // Always false in Phase 1. Present so certification state is explicit.
  certified      Boolean @default(false)
  // GENERATED | UPLOADED | OPTIMIZED — where the program text came from.
  origin         String  @default("GENERATED")
  // For OPTIMIZED rows: the program this one was derived from.
  sourceProgramId String?
  // For OPTIMIZED rows: applied proposals, digests and the geometry diff.
  optimizationAuditJson String?
  verificationIssuesJson String?
  preflightJson  String?
  generatedBy    String
  createdAt      DateTime @default(now())

  partRevision PartRevision @relation(fields: [partRevisionId], references: [id], onDelete: Cascade)
  machine      Machine?     @relation(fields: [machineId], references: [id], onDelete: SetNull)
  exportAuthorizations NCExportAuthorization[]

  @@index([partRevisionId])
}

// A single-use, short-lived permission to take NC bytes out of CANVAS.
//
// The only server surface that emits program bytes is the mint action, and it
// re-runs the pre-flight gate every time. The row exists so the export the
// operator completes is provably the export the gate approved: same digest,
// same byte count, minted minutes ago, spent once. A client cannot request
// program text by any id — it can only spend a token it was just issued.
//
// Tenancy: organizationId is written from the session at mint time and checked
// again at record time. NCProgram itself carries no organizationId column, so
// this table must never be reached by bare token without the organization
// check, and NCProgram must never be fetched by id from client input.
model NCExportAuthorization {
  id             String @id @default(cuid())
  // Random, unguessable, single-use. The client holds this and nothing else.
  token          String @unique
  organizationId String
  ncProgramId    String
  partRevisionId String
  filename       String
  byteLength     Int
  // SHA-256 of the program text, computed server-side at mint.
  digest         String
  issuedToUserId String
  expiresAt      DateTime
  consumedAt     DateTime?
  // WRITTEN_VERIFIED | WRITTEN_MISMATCH | DOWNLOAD_OFFERED | WRITE_FAILED |
  // REFUSED_GATE — what actually happened, reported at record time.
  outcome        String?
  // The leaf name the operator chose. Media type is not verifiable from a
  // browser and is deliberately not recorded as if it were.
  destinationName String?
  writtenFilename String?
  // Digest the export island computed from the read-back, verbatim.
  clientDigest   String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ncProgram    NCProgram    @relation(fields: [ncProgramId], references: [id], onDelete: Cascade)

  @@index([ncProgramId])
  @@index([organizationId])
}

model PostProcessor {
  id               String  @id
  name             String
  controllerFamily String
  certified        Boolean @default(false)
  notes            String?
}

/* ================================================================== */
/* Inspection                                                         */
/* ================================================================== */

model InspectionPlan {
  id             String @id @default(cuid())
  partRevisionId String
  name           String
  samplingPlan   String @default("FIRST_ARTICLE")
  createdAt      DateTime @default(now())

  partRevision PartRevision     @relation(fields: [partRevisionId], references: [id], onDelete: Cascade)
  items        InspectionItem[]
  results      InspectionResult[]

  @@index([partRevisionId])
}

model InspectionItem {
  id        String @id @default(cuid())
  planId    String
  featureId String?
  label     String
  nominal   Float
  plusTol   Float
  minusTol  Float
  method    String
  deviceType String?
  sequence  Int @default(0)

  plan    InspectionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature?       @relation(fields: [featureId], references: [id])
  results InspectionResult[]

  @@index([planId])
}

model InspectionResult {
  id        String @id @default(cuid())
  planId    String
  itemId    String
  jobId     String?
  measured  Float
  pass      Boolean
  inspector String?
  measuredAt DateTime @default(now())
  notes     String?

  plan InspectionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  item InspectionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  job  Job?           @relation(fields: [jobId], references: [id])

  @@index([planId])
}

/* ================================================================== */
/* Jobs, outcomes and institutional memory                            */
/* ================================================================== */

model Job {
  id             String @id @default(cuid())
  organizationId String
  partId         String
  revision       String
  jobNumber      String
  quantity       Int
  status         String @default("PLANNED") // PLANNED | SETUP | RUNNING | COMPLETE | CANCELLED
  dueDate        DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  actualCycleMinutes Float?
  actualSetupHours   Float?
  scrapCount     Int @default(0)
  notes          String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  part         Part         @relation(fields: [partId], references: [id], onDelete: Cascade)
  outcomes     JobOutcome[]
  inspectionResults InspectionResult[]
  disagreements Disagreement[]

  @@index([organizationId])
  @@index([partId])
}

model JobOutcome {
  id        String @id @default(cuid())
  jobId     String
  code      String
  operationId String?
  toolNumber Int?
  cause     String
  correctiveAction String
  partsAffected Int @default(0)
  notes     String?
  recordedBy String?
  recordedAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

// The long-term institutional record: what was made, how, and what happened.
// Written once a job completes and never edited in place.
model ManufacturingDNA {
  id        String @id @default(cuid())
  partId    String
  revision  String
  jobId     String?
  snapshotJson String // geometry, setups, tooling, feeds, workholding at run time
  actualResultsJson String? // measured results, cycle time, tool wear, scrap
  costActual Float?
  supplierId String?
  recordedAt DateTime @default(now())

  part     Part      @relation(fields: [partId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([partId])
}

/* ================================================================== */
/* Commercial                                                         */
/* ================================================================== */

model Quote {
  id             String @id @default(cuid())
  organizationId String
  partId         String
  quoteNumber    String
  customer       String?
  status         String @default("DRAFT")
  createdAt      DateTime @default(now())
  validUntil     DateTime?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  part         Part           @relation(fields: [partId], references: [id], onDelete: Cascade)
  estimates    CostEstimate[]

  @@index([organizationId])
}

model CostEstimate {
  id             String @id @default(cuid())
  partRevisionId String
  quoteId        String?
  quantity       Int
  // The full assumption set, stored so a quote can always be defended.
  assumptionsJson String
  linesJson      String
  unitCost       Float
  unitPrice      Float
  lotPrice       Float
  createdAt      DateTime @default(now())
  createdBy      String?

  partRevision PartRevision @relation(fields: [partRevisionId], references: [id], onDelete: Cascade)
  quote        Quote?       @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([partRevisionId])
}

model Supplier {
  id             String @id @default(cuid())
  organizationId String
  name           String
  capabilities   String @default("[]") // JSON array
  certifications String @default("[]") // JSON array
  leadTimeDays   Int?
  notes          String?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dna          ManufacturingDNA[]

  @@index([organizationId])
}

/* ================================================================== */
/* Network — architected, gated off by default                        */
/* ================================================================== */

// Anonymous, lossy, and never linked to identity in a shared context.
// See /docs/NETWORK_PRIVACY.md for what is deliberately absent here.
model NetworkFingerprint {
  id             String @id @default(cuid())
  organizationId String
  partId         String
  fingerprintJson String
  // Only ever published when the part's sharing level permits it.
  published      Boolean @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  part         Part         @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model NetworkPermission {
  id             String @id @default(cuid())
  organizationId String
  scope          String // ORG | PART
  targetId       String?
  level          String @default("PRIVATE")
  grantedBy      String
  grantedAt      DateTime @default(now())
  revokedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/* ================================================================== */
/* Conversation, recommendations, audit                               */
/* ================================================================== */

model Conversation {
  id             String @id @default(cuid())
  organizationId String
  partId         String?
  title          String @default("Copilot")
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  part         Part?         @relation(fields: [partId], references: [id], onDelete: Cascade)
  messages     ConversationMessage[]

  @@index([organizationId])
}

model ConversationMessage {
  id             String @id @default(cuid())
  conversationId String
  role           String // user | assistant
  content        String
  // What project data the answer actually used. Empty means it used none.
  referencesJson String?
  needsJson      String?
  providerId     String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// Every AI suggestion is recorded as a proposal with an explicit acceptance
// state. Nothing a model proposes is applied without passing through here.
model AIRecommendation {
  id             String @id @default(cuid())
  partRevisionId String
  kind           String // FEATURE | MEASUREMENT | PROCESS | WORKHOLDING | NOMINAL
  summary        String
  payloadJson    String
  providerId     String
  confidence     Float?
  status         String @default("PROPOSED") // PROPOSED | ACCEPTED | REJECTED | SUPERSEDED
  decidedBy      String?
  decidedAt      DateTime?
  createdAt      DateTime @default(now())

  partRevision PartRevision @relation(fields: [partRevisionId], references: [id], onDelete: Cascade)

  @@index([partRevisionId])
}

model Approval {
  id             String @id @default(cuid())
  partRevisionId String
  userId         String
  scope          String // MANUFACTURING_PACKAGE | NC_EXPORT | CRITICAL_APPLICATION
  approvedAt     DateTime @default(now())
  statement      String
  revokedAt      DateTime?

  partRevision PartRevision @relation(fields: [partRevisionId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@index([partRevisionId])
}

// Append-only. Manufacturing requires history: who changed a feed, a
// tolerance, a material, when, and whether it was a human or a model.
model AuditLog {
  id             String @id @default(cuid())
  organizationId String
  userId         String?
  entityType     String
  entityId       String
  action         String // CREATE | UPDATE | DELETE | APPROVE | GENERATE | EXPORT | ACCEPT_SUGGESTION
  field          String?
  oldValue       String?
  newValue       String?
  // HUMAN | AI | SYSTEM — never inferred, always set explicitly by the caller.
  actorType      String @default("HUMAN")
  reason         String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([entityType, entityId])
}

/* ------------------------------------------------------------------ */
/* PHASE 2                                                             */
/* ------------------------------------------------------------------ */

// OPERATION-STATE GEOMETRY
//
// A component is not one shape. It is stock, then a sequence of intermediate
// shapes, then the finished part — and almost every question worth asking is
// about one of the intermediate ones. "Is there enough material to clamp on"
// and "is this wall thin enough to buzz" have different answers before and
// after Op 20.
//
// This records the state of the part at a point in the process so that
// workholding, rigidity and tool-access analysis can reference the geometry as
// it actually is during a given operation rather than as it is at the end.
//
// The material-removal solid modelling that would populate `derivedGeometryJson`
// automatically is DEVELOPMENT. What exists now is the addressable state and
// the scalar envelope, which is what the holding model consumes.
model OperationState {
  id             String @id @default(cuid())
  partRevisionId String
  setupId        String?
  // Ordering key across the whole process, e.g. 0 for stock, 10, 20, 30.
  sequence       Int
  kind           String // STOCK | AFTER_OPERATION | FINAL
  label          String

  // Bounding envelope of the part in this state.
  envelopeX Float?
  envelopeY Float?
  envelopeZ Float?

  // Volume remaining, in³, and the mass that follows from it.
  remainingVolume Float?
  removedVolume   Float?

  // Thinnest wall present in this state. The number that decides whether the
  // part can be clamped where the plan says to clamp it.
  minWallThickness Float?
  // Whether the surfaces the previous setup gripped still exist.
  clampingSurfacesIntact Boolean @default(true)

  // Reserved for the solid model once material removal is implemented.
  derivedGeometryJson String?
  // How this state was arrived at, so nothing here is mistaken for measured.
  source     String @default("CALCULATED")
  confidence String @default("LOW")
  notes      String?

  partRevision PartRevision @relation(fields: [partRevisionId], references: [id], onDelete: Cascade)

  @@unique([partRevisionId, sequence])
  @@index([partRevisionId])
}

// SHOP KNOWLEDGE
//
// What this shop has learned on this machine with this tool, which is not the
// same category of fact as a published feed and speed and must never be
// promoted into one. It is evidence, it is scoped, and it carries its sample
// size so a claim backed by one job reads differently from a claim backed by
// seventeen.
model ShopKnowledge {
  id             String @id @default(cuid())
  organizationId String

  // What the observation is about. Any subset may be set; the more that are,
  // the narrower and more trustworthy the claim.
  machineId    String?
  toolId       String?
  materialId   String?
  toolClass    String?
  toolDiameter Float?

  category    String // TOOL_BEHAVIOUR | FIXTURE_BEHAVIOUR | MACHINE_BEHAVIOUR | MATERIAL_BEHAVIOUR | INSPECTION_OUTCOME | OPERATOR_CORRECTION
  observation String

  // The quantitative boundary, when the observation has one.
  parameter     String? // e.g. "axialDepth"
  thresholdValue Float?
  thresholdUnit  String?
  direction      String? // ABOVE | BELOW

  // Evidence behind it.
  origin        String @default("OPERATOR") // OPERATOR | SUCCESSFUL_JOB | FAILED_JOB | INSPECTION | DISAGREEMENT
  jobCount      Int    @default(1)
  lastObservedAt DateTime @default(now())
  recordedById  String?
  confidence    String @default("LOW")
  // Set false to retire a belief without deleting the history behind it.
  active        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  machine      Machine?     @relation(fields: [machineId], references: [id], onDelete: SetNull)
  tool         Tool?        @relation(fields: [toolId], references: [id], onDelete: SetNull)
  material     Material?    @relation(fields: [materialId], references: [id], onDelete: SetNull)
  recordedBy   User?        @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  disagreements Disagreement[]

  @@index([organizationId])
  @@index([organizationId, category])
}

// "I DISAGREE"
//
// An experienced machinist disagreeing with CANVAS is information, not noise,
// and it is the single richest source of shop knowledge available.
//
// Recording a disagreement does NOT clear a required safety gate. It is
// evidence to be evaluated, and the gate it relates to stays where it was
// until the underlying evidence changes.
model Disagreement {
  id             String @id @default(cuid())
  organizationId String
  userId         String?

  // What is being disagreed with.
  subjectType String // READINESS_GATE | WORKHOLDING | TOOL_CHOICE | FEED_SPEED | PROCESS | NOMINAL | COST | OTHER
  subjectId   String?
  partRevisionId String?
  setupId        String?
  canvasPosition String // what CANVAS said, captured verbatim at the time

  reasoning       String
  hasRunComparable Boolean @default(false)
  comparableJobId  String?
  proposedValue    String?

  // Resolution. A disagreement stays OPEN until somebody does something about
  // it; it never silently clears anything.
  status       String  @default("OPEN") // OPEN | ACCEPTED_AS_KNOWLEDGE | EVIDENCE_REQUESTED | DECLINED | SUPERSEDED
  resolution   String?
  gateCleared  Boolean @default(false)
  shopKnowledgeId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  partRevision  PartRevision? @relation(fields: [partRevisionId], references: [id], onDelete: Cascade)
  comparableJob Job?          @relation(fields: [comparableJobId], references: [id], onDelete: SetNull)
  shopKnowledge ShopKnowledge? @relation(fields: [shopKnowledgeId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([partRevisionId])
}

// DATUM-FIRST REVERSE ENGINEERING
//
// Reverse engineering is not a pile of disconnected dimensions. A bore is
// 2.000 *from something*, and until that something is named, the number is
// not reproducible — the next person measures from a different edge and gets
// a different answer that is equally defensible.
//
// Three datum systems, because they are genuinely different questions and a
// shop that conflates them makes parts that inspect fine and do not fit:
//
//   DESIGN        what the part's function is referenced to
//   MANUFACTURING what the part is located from in the fixture
//   INSPECTION    what it is set up on to be measured
//
// They often differ, and where they differ, error stacks between them. Naming
// all three is what lets CANVAS say by how much.
model Datum {
  id             String @id @default(cuid())
  partRevisionId String
  // A, B, C — the reference letter used on the drawing and in inspection.
  letter         String
  system         String // DESIGN | MANUFACTURING | INSPECTION
  // What the datum physically is. A face, a bore centreline, a dowel centre.
  featureId      String?
  description    String
  // PLANE | AXIS | POINT — governs how many degrees of freedom it constrains.
  geometryType   String @default("PLANE")

  // Why CANVAS proposed it, kept verbatim so the operator can disagree with
  // the reasoning rather than only with the conclusion.
  proposedReason String?
  // Datums are never established by inference alone.
  acceptedByUser Boolean  @default(false)
  acceptedAt     DateTime?
  source         String   @default("SYSTEM")

  createdAt DateTime @default(now())

  partRevision PartRevision @relation(fields: [partRevisionId], references: [id], onDelete: Cascade)
  feature      Feature?     @relation(fields: [featureId], references: [id], onDelete: SetNull)
  measurements Measurement[]

  @@unique([partRevisionId, system, letter])
  @@index([partRevisionId])
}

// Per-user viewport visibility settings. Display only — nothing here touches
// a gate, a measurement or provenance. The env shape is owned by
// src/lib/view-environment.ts and stored as JSON so display tuning does not
// require a migration.
model ViewPreference {
  id             String @id @default(cuid())
  organizationId String
  userId         String @unique

  envJson          String
  savedPresetsJson String @default("[]")

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([organizationId])
}
